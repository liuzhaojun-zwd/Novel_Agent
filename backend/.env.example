# Novel_Agent — 环境配置

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-chat
# Optional purpose tiers; blank falls back to LLM_MODEL
LLM_FAST_MODEL=
LLM_QUALITY_MODEL=
LLM_INPUT_COST_PER_MILLION=0.5
LLM_OUTPUT_COST_PER_MILLION=2.0
LLM_TEMPERATURE=0.8
# Set false on API replicas when running `python -m app.worker` separately
TASK_WORKER_ENABLED=true
DATABASE_PATH=data/novel_agent.db
HOST=0.0.0.0
PORT=8000